
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LQ FREE ACC - Login</title>
<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
body {
    background: #080812;
    color: white;
    font-family: Arial, sans-serif;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}
.login-box {
    width: 100%;
    max-width: 400px;
    background: #151525;
    border: 1px solid #873cff;
    border-radius: 20px;
    padding: 30px 25px;
    text-align: center;
    box-shadow: 0 0 30px #873cff40;
}
.logo {
    font-size: 55px;
    margin-bottom: 15px;
}
h1 {
    color: #c084fc;
    font-size: 25px;
    margin-bottom: 12px;
}
p {
    color: #999;
    font-size: 14px;
    margin-bottom: 25px;
}
input {
    width: 100%;
    padding: 15px;
    margin-bottom: 15px;
    background: #090914;
    border: 1px solid #49356b;
    border-radius: 10px;
    color: white;
    outline: none;
    font-size: 15px;
}
input:focus {
    border-color: #a855f7;
}
button {
    width: 100%;
    padding: 15px;
    background: linear-gradient(90deg,#7c3aed,#a855f7,#06b6d4);
    border: none;
    border-radius: 10px;
    color: white;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
}
#message {
    margin-top: 18px;
    font-size: 14px;
}
.footer {
    margin-top: 25px;
    color: #666;
    font-size: 12px;
}
</style>
</head>
<body>

<div class="login-box">
    <div class="logo">🎮</div>

    <h1>LQ FREE ACC</h1>
    <p>Đăng nhập để tiếp tục vào hệ thống</p>

    <input
        type="text"
        id="username"
        placeholder="👤 Tên đăng nhập"
    >

    <input
        type="password"
        id="password"
        placeholder="🔒 Mật khẩu"
    >

    <button onclick="login()">ĐĂNG NHẬP</button>

    <div id="message"></div>

    <div class="footer">
        © 2026 LQ FREE ACC
    </div>
</div>

<script>
function login() {
    const username =
        document.getElementById("username").value.trim();

    const password =
        document.getElementById("password").value;

    const message =
        document.getElementById("message");

    if (!username || !password) {
        message.style.color = "#f87171";
        message.innerText = "⚠️ Vui lòng nhập đầy đủ thông tin!";
        return;
    }

    message.style.color = "#4ade80";
    message.innerText = "Đã nhận thông tin đăng nhập!";

    // Chưa kết nối hệ thống xác thực tài khoản.
}
</script>

</body>
</html>
